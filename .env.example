# ---------------------------------------------------------------------------
#  Copy this file to ".env" (same folder) and fill in your own values.
#  .env is in .gitignore — NEVER commit it, screenshot it or paste it in chat.
#  On Render / Replit put these in the "Environment" / "Secrets" panel instead.
#  Anything left empty is simply switched off.
# ---------------------------------------------------------------------------

# === REQUIRED ==============================================================
# Postgres connection string (Render/Neon/Supabase give you one).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bizapp

# The public https address of your shop, no trailing slash.
# Needed for online payments (return + webhook URLs), OAuth and email links.
PUBLIC_URL=http://localhost:8080

NODE_ENV=development             # use "production" when deployed

# === FIRST OWNER ACCOUNT (only used while there are no staff accounts) =====
# Either fill these in, or leave them empty and use the /admin setup page.
# After the first start you can (and should) delete OWNER_PASSWORD.
OWNER_USERNAME=
OWNER_EMAIL=
OWNER_PASSWORD=                  # 12+ characters
# OWNER_NAME=Owner
# Token the /admin setup page asks for. ALWAYS required in production
# (generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))").
SETUP_TOKEN=

# === PAYMENTS (keys live ONLY here; the owner switches methods on/off in Admin → Payments & delivery)
# Cash on delivery needs no keys.

# Flutterwave (MTN MoMo, Airtel Money, cards). Dashboard → Settings → API keys.
# Test keys start with FLWSECK_TEST-, live keys with FLWSECK-.
FLW_SECRET_KEY=
# A long random string YOU choose; paste the same value in Flutterwave → Settings → Webhooks → Secret hash.
FLW_SECRET_HASH=
# FLW_PAYMENT_OPTIONS=mobilemoneyuganda,card   # what the hosted page offers
# FLW_FALLBACK_EMAIL=orders@yourshop.com       # used when a customer gives no email (Flutterwave needs one)

# Pesapal (MTN MoMo, Airtel Money, cards). developer.pesapal.com → sandbox / live keys.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox              # "sandbox" (cybqa.pesapal.com) or "live"
# PESAPAL_IPN_ID=                # optional: the server registers its IPN URL automatically

# PAYMENT_TIMEOUT_MINUTES=60     # unpaid online orders are cancelled and stock released after this
# JOB_INTERVAL_SECONDS=300       # how often pending payments are re-checked

# === NOTIFICATIONS (empty = messages are only written to the server log) ===
# Email via any SMTP provider (Gmail app password, Brevo, Mailgun, Zoho...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                # true for port 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Shop <orders@yourshop.com>"
# SMS via Africa's Talking. For testing use AT_USERNAME=sandbox with a sandbox key.
AT_USERNAME=
AT_API_KEY=
# AT_SENDER_ID=                  # approved sender ID / short code (optional)
# Where "new order" alerts for the shop go:
NOTIFY_SHOP_EMAIL=
NOTIFY_SHOP_PHONE=               # e.g. +256772123456

# === OPTIONAL "Sign in with Google / GitHub" (existing staff only) =========
# Callback URLs: <PUBLIC_URL>/api/auth/oauth/google/callback and .../github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === OPTIONAL TUNING ========================================================
# PORT=8080
# LOG_LEVEL=info                 # JSON logs in production
# SESSION_HOURS=8                # max staff session length (1–168)
# SESSION_IDLE_MINUTES=60        # sign out after inactivity
# LOGIN_MAX_ATTEMPTS=5           # wrong passwords before an account locks
# LOGIN_LOCK_MINUTES=15
# COOKIE_SECURE=true             # defaults to true when NODE_ENV=production
# TRUST_PROXY=1                  # Render/Replit sit behind one proxy
# CORS_ORIGINS=                  # only if the shop front is on a DIFFERENT domain
# REDIS_URL=                     # share rate limits between several server instances
# RATE_LIMIT_SCALE=1             # tests only: multiplies rate limits; ignored in production
# UPLOAD_STORAGE=db              # "db" (default, survives redeploys) or "disk"
# UPLOAD_DIR=./uploads           # only for UPLOAD_STORAGE=disk — use a persistent disk!
# UPLOAD_MAX_MB=2                # max image size (max 10)
# RUN_MIGRATIONS=true            # apply lib/db/migrations on start
# SEED_FILE=business/seed/data.json
# SEED_ON_START=true             # fill an EMPTY database with the starter catalogue
# SERVE_STATIC=true              # the API also serves the built shop front
# DATABASE_POOL_MAX=10

# === Frontend dev server only (pnpm dev:web) ================================
# API_URL=http://localhost:8080
# BASE_PATH=/
# WEB_PORT=5173
