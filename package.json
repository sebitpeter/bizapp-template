{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node ./scripts/check-pnpm.cjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/storefront run dev",
    "db:push": "pnpm --filter @workspace/db run push",
    "smoke": "node --env-file-if-exists=.env scripts/smoke-test.mjs",
    "db:migrate": "pnpm --filter @workspace/db run migrate",
    "db:generate": "pnpm --filter @workspace/db run generate",
    "test": "node scripts/run-tests.mjs"
  },
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
